                <mxCell id="n15" value="AskQuestion:&lt;br&gt;abortar / usar branch atual&lt;br&gt;não-protegida / criar nova branch&lt;br&gt;(nome precisa de aprovação explícita)" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" parent="1" vertex="1">
