                <mxCell id="n27" value="pre-plan/merged-brief.md&lt;br&gt;+ pre-plan/specialists/*.md" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;size=16" parent="1" vertex="1">
                    <mxGeometry x="1320" y="1585" width="340" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n28" value="Task(prd) → Task(spectech) → Task(tasks)&lt;br&gt;— sequencial (1ª tentativa);&lt;br&gt;rework: só a(s) persona(s) alvo do feedback" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="1320" y="1710" width="340" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n29" value="Task(plan-reviewer) — modo pasta&lt;br&gt;(cobertura cross-artifact PRD/Spectech/Tasks)&lt;br&gt;MERGE:plan-reviewer-1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="1320" y="1873" width="340" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n30" value="Aceito?&lt;br&gt;verdict PASS OU score ≥ threshold&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-weight: 700;&quot;&gt;MERGE:plan-reviewer-1&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="1360" y="2007" width="260" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n31" value="session-memory:&lt;br&gt;PLAN_REVIEW_FEEDBACK&lt;br&gt;(attempt n | persona alvo)&lt;br&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 255);&quot;&gt;REWORK:plan-reviewer-1&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="1829" y="2022" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n32" value="AskQuestion — intervenção humana&lt;br&gt;(--max-plan-iterations atingido):&lt;br&gt;Proceder mesmo assim / Abortar /&lt;br&gt;Fornecer orientação" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="826" y="2170" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n33" value="Abortar" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="886" y="2332" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n34" value="Task(scrum) — gate do plano&lt;br&gt;(PRD/Spectech/Tasks)&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;MERGE:plan-reviewer-1&lt;/span&gt;" style="hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="1320" y="2185" width="340" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n74" value="&lt;b&gt;Legenda de formas&lt;/b&gt;&lt;br&gt;⬭ verde = início/fim &amp;nbsp; ⬭ vermelho = abort&lt;br&gt;▭ azul = passo/processo do orquestrador&lt;br&gt;▭ azul negrito = Task(persona) delegada&lt;br&gt;▱ roxo = Task(mcp-*) — especialista MCP&lt;br&gt;◇ laranja = decisão/desvio&lt;br&gt;⬣ verde = Task(scrum) — gate de negócio&lt;br&gt;🗒 amarelo = artefato persistido em disco&lt;br&gt;▱ laranja = AskQuestion (humano decide)&lt;br&gt;- - - vermelho = loop de rework&lt;br&gt;- - - laranja = atalho de --skip" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=top" parent="1" vertex="1">
                    <mxGeometry x="1820" y="40" width="340" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="n75" value="&lt;b&gt;Flags que geram desvios&lt;/b&gt;&lt;br&gt;--skip plan | impl-review | qa | summary&lt;br&gt;--manual (gates manuais Proceed/Force review/Add context)&lt;br&gt;--review (checkpoints extras, ortogonal a --manual)&lt;br&gt;--confidence N (default 75; limiar PROCEED)&lt;br&gt;--max-iterations N (default 3; rework §6/§7.1)&lt;br&gt;--max-plan-iterations N (default 3; loop §3-4)&lt;br&gt;--branch [nome] (sugestão; aprovação sempre explícita)&lt;br&gt;--resume (retoma do último GATE:/FAILURE:)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=top" parent="1" vertex="1">
                    <mxGeometry x="1820" y="300" width="340" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="n76" value="&lt;b&gt;Tratamento de erro (qualquer etapa)&lt;/b&gt;&lt;br&gt;Falha em qualquer Task → log-gate failure →&lt;br&gt;pipeline para → sugere /fix, /do, --resume,&lt;br&gt;ou reexecutar /run. Track paralelo (§5) com&lt;br&gt;QUESTION/ASK_USER/APPROVAL_NEEDED pausa a fase." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=top" parent="1" vertex="1">
                    <mxGeometry x="1820" y="580" width="340" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="n77" value="&lt;b&gt;Conclusão inválida (não é PIPELINE: COMPLETE)&lt;/b&gt;&lt;br&gt;- ORCHESTRATION_ABORTED / implementação sem Task&lt;br&gt;- pular PRD/Spectech/Tasks, QA, Summary ou revisões&lt;br&gt;&amp;nbsp;&amp;nbsp;sem a flag --skip correspondente&lt;br&gt;- pular §6 sem --skip impl-review (por fase)&lt;br&gt;- Task(dev|sre|data) cobrindo &amp;gt;1 ### Phase N:&lt;br&gt;- persona edita checkbox/status antes do&lt;br&gt;&amp;nbsp;&amp;nbsp;Task(scrum) PROCEED&lt;br&gt;- &quot;N/A&quot; em massa para scores/modelos&lt;br&gt;- roadmap fora de sync (§7.1) e mesmo assim completo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;align=left;verticalAlign=top" parent="1" vertex="1">
                    <mxGeometry x="1820" y="730" width="566" height="300" as="geometry"/>
                </mxCell>
