                <mxCell id="n21" value="Task(pre-plan-triage):&lt;br&gt;classifica fontes MCP (wave1/wave2) e caps" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" parent="1" vertex="1">
