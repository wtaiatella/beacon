{
  "beacon-shell-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "command": "bash ./hooks/before-shell.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "beacon-read-gate": {
    "PreToolUse": [
      {
        "matcher": "view_file|read_file",
        "hooks": [
          {
            "command": "bash ./hooks/before-read.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "beacon-write-gate": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|write_file|edit_file",
        "hooks": [
          {
            "command": "bash ./hooks/subagent-gate.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "beacon-format-on-edit": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|write_file|edit_file",
        "hooks": [
          {
            "command": "bash ./hooks/format-on-edit.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "beacon-session-init": {
    "PreInvocation": [
      {
        "command": "bash ./hooks/session-init.sh",
        "timeout": 30
      }
    ]
  },
  "beacon-session-end": {
    "Stop": [
      {
        "command": "bash ./hooks/audit-log.sh",
        "timeout": 30
      },
      {
        "command": "bash ./hooks/session-verify.sh",
        "timeout": 30
      }
    ]
  }
}
