{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/before-shell.sh"
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/before-read.sh"
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/subagent-gate.sh",
        "matcher": "Write"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/format-on-edit.sh"
      }
    ],
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-init.sh"
      }
    ],
    "sessionEnd": [
      {
        "command": ".cursor/hooks/audit-log.sh"
      },
      {
        "command": ".cursor/hooks/session-verify.sh"
      }
    ]
  }
}
