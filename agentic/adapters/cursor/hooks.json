{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/beacon/before-shell.sh"
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/beacon/before-read.sh"
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/beacon/subagent-gate.sh",
        "matcher": "Write"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/beacon/format-on-edit.sh"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/beacon/tool-audit.sh"
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/beacon/tool-audit.sh"
      }
    ],
    "postToolUseFailure": [
      {
        "command": ".cursor/hooks/beacon/tool-audit.sh"
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/beacon/tool-audit.sh"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/beacon/tool-audit.sh"
      }
    ],
    "sessionStart": [
      {
        "command": ".cursor/hooks/beacon/session-init.sh"
      }
    ],
    "sessionEnd": [
      {
        "command": ".cursor/hooks/beacon/audit-log.sh"
      },
      {
        "command": ".cursor/hooks/beacon/session-verify.sh"
      }
    ]
  }
}
