# Ignore everything by default (child repos, temp files, etc.)
*

# Whitelist workspace framework files
!.gitignore
!.gitlab-ci.yml
!README.md
!CONTRIBUTING.md

# Canonical SDD framework (source of truth — edit here, install with setup-agentic.sh)
!agentic/
!agentic/**

# Per-install, per-IDE model override (optional, local to this checkout/
# machine — see agentic/models/example.yml, the only tracked file in that dir).
agentic/models/*.yml
!agentic/models/example.yml

# IDE runtimes (.cursor/, .claude/ framework mirror, root CLAUDE.md) are
# GENERATED by scripts/setup-agentic.sh and must not be committed.
# Project overlays (any name, outside the SDD) are tracked under .agents/ —
# no naming-prefix convention: anything placed in .agents/{agents,commands,
# skills}/ is an overlay by virtue of living in that dedicated tree.
# .claude/ holds symlinks so Claude Code can see them. Cursor reads skills
# from .agents/skills/ and gets agents/commands via symlinks that setup
# writes under .cursor/ (that tree stays gitignored — framework content
# there lives under a `beacon/` subfolder; see scripts/setup-agentic.sh).

!.agents/
!.agents/agents/
!.agents/agents/**
!.agents/commands/
!.agents/commands/**
!.agents/skills/
!.agents/skills/**

# Claude entrypoints: symlinks to .agents/ (do not un-ignore contents)
!.claude/
!.claude/agents/
!.claude/agents/**
!.claude/commands/
!.claude/commands/**
!.claude/skills/
!.claude/skills/**

# User-local orchestrator prefs (PROJECTS_ROOT, optional future keys)
/.env.local

# Shared project MCP baseline (not yet generated by setup — leave tracked)
!.mcp.json

# Setup, tooling, and documentation
!scripts/
!scripts/**
!docs/
!docs/**

# Finder metadata (docs/** is whitelisted above)
.DS_Store
**/.DS_Store

# Adapter-installed IDE docs (generated into docs/adapters/ by setup-agentic.sh)
docs/adapters/

# Knowledge base (shared project context, tracked in git)
!knowledge/
!knowledge/**

# Specs are developer working artifacts, NOT tracked
# (created at runtime by setup.sh, used locally per developer; in this workspace docs/specs is a
# symlink into another local workspace directory, so it's shared across both — no trailing slash here:
# a trailing-slash pattern only matches real directories and silently lets a symlink through)
docs/specs

# Session memory (ephemeral, per-developer); README for conventions is tracked
docs/sessions/*
!docs/sessions/README.md

# Legacy session shim names at repository root only (ROAD-53); does not affect docs/** or tracked session README
/exploration
/qa-artifacts

# Local audit log (created by sessionEnd hook)
docs/audit.log

# Local per-tool audit logs (A/B Claude vs Cursor studies)
docs/local/
scripts/tools/__pycache__
