# Ignore everything by default (child repos, temp files, etc.)
*

# Whitelist workspace framework files
!.gitignore
!.gitlab-ci.yml
!CODEOWNERS
!README.md
!CONTRIBUTING.md

# Canonical SDD framework (source of truth — edit here, install with setup-agentic.sh)
!agentic/
!agentic/**

# IDE runtimes (.agents/, .cursor/, .claude/ framework mirrors, root CLAUDE.md)
# are GENERATED by scripts/setup-agentic.sh and must not be committed.
# Exception below: project overlays (bcs-*) live only under .claude/ for now.

# Project overlays (outside agentic/ SDD) — keep tracked under .claude/
!.claude/
!.claude/agents/
!.claude/agents/bcs-*.md
!.claude/commands/
!.claude/commands/bcs-*.md
!.claude/skills/
!.claude/skills/bcs-*/
!.claude/skills/bcs-*/**

# User-local orchestrator prefs (PROJECTS_ROOT, optional future keys)
/.env.local

# Shared project MCP baseline (not yet generated by setup — leave tracked)
!.mcp.json

# Setup, tooling, and documentation
!scripts/
!scripts/**
!docs/
!docs/**

# Adapter-installed IDE docs (generated into docs/adapters/ by setup-agentic.sh)
docs/adapters/

# Knowledge base (shared project context, tracked in git)
!knowledge/
!knowledge/**

# Specs are developer working artifacts, NOT tracked
# (created at runtime by setup.sh, used locally per developer; in this workspace docs/specs is a
# symlink into the sibling `bcs` workspace, so it's shared across both — no trailing slash here:
# a trailing-slash pattern only matches real directories and silently lets a symlink through)
docs/specs

# Session memory (ephemeral, per-developer); README for conventions is tracked
docs/sessions/*
!docs/sessions/README.md

# Legacy session shim names at repository root only (ROAD-53); does not affect docs/** or tracked session README
/exploration
/qa-artifacts

# Local audit log (created by sessionEnd hook)
docs/audit.log
scripts/tools/__pycache__
