# Ignore agent/IDE-generated directories and ephemeral/local artifacts.
# Everything else in this workspace is tracked by default — this workspace
# root is meant to double as a real project's own repo (specs, knowledge,
# and any other project-specific files belong in git), not just the SDD
# framework's own dev checkout. Pattern for project use: point `origin` at
# your project's remote and keep an `upstream` remote only to pull framework
# updates from `agentic/` — tracking/.gitignore is per-worktree, not
# per-remote, so there is no way to "ignore X only for remote B".

# IDE runtimes generated by scripts/setup-agentic.sh. .claude/ and .agent/
# are generated wholesale. Under .cursor/, only the framework's beacon/
# subfolders are generated (agents, skills, hooks, rules). Project content
# outside those folders — skills, rules, agents — stays tracked.
.claude/
.cursor/**/beacon/
# Cursor requires hooks.json at this path; both files are regenerated by setup.
.cursor/hooks.json
.cursor/.agentic-managed
.agent/
/CLAUDE.md
/AGENTS.md
docs/adapters/

# Root .vscode/settings.json is autogenerated by /clone (git.scanRepositories
# registration) — per-developer editor config, not shared project data.
/.vscode/

# Personal working notes / scratch (diagrams, analysis drafts, etc.) — not
# part of the framework or a project's own tracked history.
/myDocs/

# Per-install, per-IDE model override (optional, local to this checkout/
# machine — see agentic/models/example.yml, the only tracked file in that dir).
agentic/models/*.yml
!agentic/models/example.yml

# User-local orchestrator prefs (PROJECTS_ROOT, optional future keys)
/.env.local

# Child repos cloned via /clone join this list automatically — one entry per
# repo, appended by scripts/tools/clone-repo.sh. Each is its own git repo and
# must never be tracked as part of this workspace's history.
# --- clone-managed entries below (do not remove this marker) ---

# Finder metadata
.DS_Store
**/.DS_Store

# Leftover local folders from before run state moved into
# docs/specs/<ticket>/_run/ (tracked with the ticket). New runs do not write here.
docs/sessions/

# Legacy session shim names at repository root only (ROAD-53); does not
# affect docs/** or the tracked session README
/exploration
/qa-artifacts

# Local audit log (created by the sessionEnd hook)
docs/audit.log

# Local per-tool audit logs (A/B Claude vs Cursor studies)
docs/local/
scripts/tools/__pycache__
